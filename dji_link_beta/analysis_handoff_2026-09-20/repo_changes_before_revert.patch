+def osd(mode, channel=2, sender=9):
+    payload = bytearray(55)
+    payload[0x1e] = mode
+    struct.pack_into('<I', payload, 0x20, channel << 13)
+    return DumlPacket(sender=sender, receiver=2, cmd_set=3, cmd_id=0x43,
+                      payload=bytes(payload))
