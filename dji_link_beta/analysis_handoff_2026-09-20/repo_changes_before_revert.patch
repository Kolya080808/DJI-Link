+            self.assertIn('confirmed by OSD', self.messages[-1])
+
+    def test_latest_request_replaces_previous(self):
+        self.cli.set_flight_mode('sport')
+        old_seq = self.t.packets()[-1].seq
+        self.cli.set_flight_mode('cine')
+        self.reply(0xe0, seq=old_seq)
+        self.cli._on_duml_payload(osd(31).encode())
+        self.assertEqual(self.cli._mode_request['gear'], 2)
+        self.cli._on_duml_payload(osd(38).encode())
+        self.assertIsNone(self.cli._mode_request)
